# secure-agent-kernel — environment.
# ONLY the variables the kernel config reads (sr_agent/config.py). Audit-only
# vars (chain RPC keys, SmartGraphical root, model-routing slots, docker-compose
# internals) live in the araratsec-agent repo's .env.example — the kernel neither
# reads nor ships them.

# ── LLM APIs ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional providers — loop runs without them (Constitution V).
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Memory integrity ──────────────────────────────────────────────────────
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the actual value. Rotation = all existing records invalidated.
SR_SECRET_KEY=

# ── Storage roots (generic kernel config slots; defaults shown) ────────────
SR_MEMORY_ROOT=./memory
# Rollback anchor (feature 006). Optional; unset leaves the rollback guard inert.
# MUST be OUTSIDE SR_MEMORY_ROOT, on a stricter access boundary (separate uid/perms/
# mount) the memory-write adversary cannot cross — the guarantee is only as strong as
# that separation. A writer-role deployment should set it.
SR_ANCHOR_ROOT=
SR_KNOWLEDGE_ROOT=./knowledge
SR_CONFIRMATIONS_ROOT=./confirmations
SR_RELAY_ROOT=./relay
SR_LESSONS_ROOT=./lessons

# ── Langfuse observability ────────────────────────────────────────────────
# Leave empty to disable tracing (langfuse_enabled=False in config).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3000
